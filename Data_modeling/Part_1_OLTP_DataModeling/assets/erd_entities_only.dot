digraph G {
graph [bgcolor="#ffffff", pad="0.4", nodesep="0.55", ranksep="0.7", outputorder="nodesfirst"];
node [shape=plain, fontname="Arial"];
edge [style=invis];
customers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#94a3b8"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><FONT FACE="Arial" POINT-SIZE="17"><B>customers</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">customer_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">first_name</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">last_name</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">email</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">phone_number</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">date_joined</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">DATE</FONT></TD></TR></TABLE>>];
products [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#94a3b8"><TR><TD COLSPAN="2" BGCOLOR="#dcfce7"><FONT FACE="Arial" POINT-SIZE="17"><B>products</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">product_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">product_name</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">category_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">price</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">stock_qty</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">INT</FONT></TD></TR></TABLE>>];
categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#94a3b8"><TR><TD COLSPAN="2" BGCOLOR="#fef3c7"><FONT FACE="Arial" POINT-SIZE="17"><B>categories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">category_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">category_name</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">VARCHAR(100)</FONT></TD></TR></TABLE>>];
orders [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#94a3b8"><TR><TD COLSPAN="2" BGCOLOR="#ede9fe"><FONT FACE="Arial" POINT-SIZE="17"><B>orders</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">order_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">customer_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">order_date</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">total_amount</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">order_status</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">store_branch_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">INT</FONT></TD></TR></TABLE>>];
order_items [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#94a3b8"><TR><TD COLSPAN="2" BGCOLOR="#ffe4e6"><FONT FACE="Arial" POINT-SIZE="17"><B>order_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">order_item_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">order_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">product_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">quantity</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">unit_price</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">DECIMAL(10,2)</FONT></TD></TR></TABLE>>];
store_branches [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#94a3b8"><TR><TD COLSPAN="2" BGCOLOR="#ccfbf1"><FONT FACE="Arial" POINT-SIZE="17"><B>store_branches</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">store_branch_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">store_branch_name</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">store_branch_location</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">VARCHAR(200)</FONT></TD></TR></TABLE>>];
payments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#94a3b8"><TR><TD COLSPAN="2" BGCOLOR="#fce7f3"><FONT FACE="Arial" POINT-SIZE="17"><B>payments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">payment_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">order_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">payment_method</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">payment_amount</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">payment_status</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">transaction_timestamp</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">DATETIME</FONT></TD></TR></TABLE>>];
shipments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#94a3b8"><TR><TD COLSPAN="2" BGCOLOR="#ffedd5"><FONT FACE="Arial" POINT-SIZE="17"><B>shipments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">shipment_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">order_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">shipping_carrier</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">tracking_number</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">shipment_status</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" POINT-SIZE="13">estimated_delivery_date</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Arial" COLOR="#475569" POINT-SIZE="12">DATE</FONT></TD></TR></TABLE>>];
{rank=same; customers; orders; payments; shipments;}
{rank=same; categories; products; order_items; store_branches;}
customers -> orders -> payments -> shipments;
categories -> products -> order_items -> store_branches;
customers -> categories;
orders -> products;
payments -> order_items;
shipments -> store_branches;
}